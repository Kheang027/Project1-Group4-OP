/*
 * mscopier.c - Multithreaded single file copier
 *
 * n reader threads claim chunks of the source file (via a shared offset
 * protected by read_mutex), read them with pread(), then enqueue them.
 * n writer threads dequeue chunks and write them with pwrite() at the
 * correct file offset.
 *
 * Usage: ./mscopier n source_file destination_file   (2 <= n <= 10)
 *
 * Design rationale:
 *   - pread/pwrite use explicit offsets and do NOT move a shared file
 *     pointer, so readers and writers can genuinely run in parallel
 *     without holding a mutex across the I/O call itself.
 *   - active_readers is stored inside the shared state and protected
 *     solely by queue_mutex.  This avoids any nested locking between
 *     read_mutex and queue_mutex, eliminating a classic deadlock pattern.
 *   - The destination file is pre-allocated with ftruncate() so pwrite()
 *     can fill any offset without creating a sparse file or overrunning
 *     the intended size.
 *   - Condition variables (not sleep()) are used throughout to avoid
 *     busy waiting.
 */

#define _POSIX_C_SOURCE 200809L
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>

#define QUEUE_MAX   20
#define CHUNK_SIZE  4096
#define MAX_THREADS 10

/* One item in the shared queue: a heap-allocated chunk with its file offset */
typedef struct {
    char   *data;
    off_t   offset;
    ssize_t size;
} queue_item_t;

typedef struct {
    /* Circular queue */
    queue_item_t    queue[QUEUE_MAX];
    int             head;
    int             tail;
    int             count;
    pthread_mutex_t queue_mutex;
    pthread_cond_t  not_full;
    pthread_cond_t  not_empty;

    /*
     * active_readers: counts reader threads still running.
     * Protected by queue_mutex (not a separate mutex) so writers can
     * check it safely while already holding queue_mutex — no nesting needed.
     */
    int active_readers;

    /* Read-offset coordination (protected by read_mutex only) */
    off_t           next_read_offset;
    off_t           file_size;
    pthread_mutex_t read_mutex;

    /* File descriptors (opened once in main, read-only / write-only) */
    int src_fd;
    int dst_fd;
} shared_state_t;

typedef struct {
    shared_state_t *state;
    int             id;
} thread_args_t;

void *reader_thread(void *arg);
void *writer_thread(void *arg);

void *reader_thread(void *arg)
{
    thread_args_t  *targs = (thread_args_t *)arg;
    shared_state_t *s     = targs->state;

    while (1) {
        // Claim the next chunk's byte range under read_mutex
        if (pthread_mutex_lock(&s->read_mutex) != 0) {
            fprintf(stderr, "Reader %d: lock read_mutex failed\n", targs->id);
            break;
        }
        if (s->next_read_offset >= s->file_size) {
            pthread_mutex_unlock(&s->read_mutex);
            break; /* nothing left to read */
        }
        off_t  my_offset = s->next_read_offset;
        size_t to_read   = CHUNK_SIZE;
        if (my_offset + (off_t)to_read > s->file_size)
            to_read = (size_t)(s->file_size - my_offset);
        s->next_read_offset += (off_t)to_read;
        pthread_mutex_unlock(&s->read_mutex);

        // Read the claimed chunk — pread is thread-safe: no shared file position
        char *buf = malloc(to_read);
        if (buf == NULL) {
            fprintf(stderr, "Reader %d: malloc failed\n", targs->id);
            break;
        }
        ssize_t nr = pread(s->src_fd, buf, to_read, my_offset);
        if (nr <= 0) {
            free(buf);
            if (nr < 0)
                fprintf(stderr, "Reader %d: pread failed: %s\n",
                        targs->id, strerror(errno));
            break;
        }

        // Enqueue the chunk — wait if queue is full
        if (pthread_mutex_lock(&s->queue_mutex) != 0) {
            fprintf(stderr, "Reader %d: lock queue_mutex failed\n", targs->id);
            free(buf);
            break;
        }
        while (s->count == QUEUE_MAX)
            pthread_cond_wait(&s->not_full, &s->queue_mutex);

        s->queue[s->tail].data   = buf;
        s->queue[s->tail].offset = my_offset;
        s->queue[s->tail].size   = nr;
        s->tail = (s->tail + 1) % QUEUE_MAX;
        s->count++;

        // Signal a writer that data is available
        pthread_cond_signal(&s->not_empty);
        pthread_mutex_unlock(&s->queue_mutex);
    }

    /*
     * Decrement active_readers under queue_mutex so writers observe
     * the change atomically with the queue count — no extra mutex needed.
     */
    if (pthread_mutex_lock(&s->queue_mutex) != 0) {
        fprintf(stderr, "Reader %d: lock queue_mutex (exit) failed\n", targs->id);
        return NULL;
    }
    s->active_readers--;
    // Last reader: broadcast to wake all waiting writers
    if (s->active_readers == 0)
        pthread_cond_broadcast(&s->not_empty);
    pthread_mutex_unlock(&s->queue_mutex);

    return NULL;
}

void *writer_thread(void *arg)
{
    thread_args_t  *targs = (thread_args_t *)arg;
    shared_state_t *s     = targs->state;

    while (1) {
        // Acquire queue lock
        if (pthread_mutex_lock(&s->queue_mutex) != 0) {
            fprintf(stderr, "Writer %d: lock queue_mutex failed\n", targs->id);
            break;
        }

        // Wait while the queue is empty and readers are still running
        while (s->count == 0 && s->active_readers > 0)
            pthread_cond_wait(&s->not_empty, &s->queue_mutex);

        // Exit when queue is drained and no more data is coming
        if (s->count == 0 && s->active_readers == 0) {
            pthread_mutex_unlock(&s->queue_mutex);
            break;
        }

        // Dequeue one item
        queue_item_t item = s->queue[s->head];
        s->head = (s->head + 1) % QUEUE_MAX;
        s->count--;

        // Signal a reader that space is available
        pthread_cond_signal(&s->not_full);
        pthread_mutex_unlock(&s->queue_mutex);

        // Write at the exact file offset — pwrite is thread-safe
        ssize_t nw = pwrite(s->dst_fd, item.data, (size_t)item.size, item.offset);
        if (nw < 0)
            fprintf(stderr, "Writer %d: pwrite failed: %s\n",
                    targs->id, strerror(errno));
        else if (nw != item.size)
            fprintf(stderr, "Writer %d: partial write (%zd of %zd bytes)\n",
                    targs->id, nw, item.size);

        // Free the heap-allocated chunk
        free(item.data);
    }

    return NULL;
}

int main(int argc, char **argv)
{
    // Validate argument count
    if (argc != 4) {
        fprintf(stderr, "Usage: %s n source_file destination_file\n", argv[0]);
        return EXIT_FAILURE;
    }

    // Validate n is within the allowed range
    int n = atoi(argv[1]);
    if (n < 2 || n > 10) {
        fprintf(stderr, "Error: n must be between 2 and 10\n");
        return EXIT_FAILURE;
    }

    const char *src_path = argv[2];
    const char *dst_path = argv[3];

    // Stat the source file to get its size
    struct stat st;
    if (stat(src_path, &st) != 0) {
        fprintf(stderr, "Error: cannot stat '%s': %s\n",
                src_path, strerror(errno));
        return EXIT_FAILURE;
    }

    // Open source file (read-only)
    int src_fd = open(src_path, O_RDONLY);
    if (src_fd < 0) {
        fprintf(stderr, "Error: cannot open '%s': %s\n",
                src_path, strerror(errno));
        return EXIT_FAILURE;
    }

    // Create / truncate destination file (write-only)
    int dst_fd = open(dst_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (dst_fd < 0) {
        fprintf(stderr, "Error: cannot open '%s': %s\n",
                dst_path, strerror(errno));
        close(src_fd);
        return EXIT_FAILURE;
    }

    // Pre-allocate destination to exact source size so pwrite can fill any offset
    if (st.st_size > 0 && ftruncate(dst_fd, st.st_size) != 0) {
        fprintf(stderr, "Error: ftruncate failed: %s\n", strerror(errno));
        close(src_fd);
        close(dst_fd);
        return EXIT_FAILURE;
    }

    // Initialise shared state
    shared_state_t state;
    memset(&state, 0, sizeof(state));
    state.file_size      = st.st_size;
    state.active_readers = n;
    state.src_fd         = src_fd;
    state.dst_fd         = dst_fd;

    // Initialise synchronisation primitives
    if (pthread_mutex_init(&state.queue_mutex, NULL) != 0 ||
        pthread_mutex_init(&state.read_mutex,  NULL) != 0 ||
        pthread_cond_init(&state.not_full,  NULL) != 0 ||
        pthread_cond_init(&state.not_empty, NULL) != 0) {
        fprintf(stderr, "Error: failed to initialise synchronisation primitives\n");
        close(src_fd);
        close(dst_fd);
        return EXIT_FAILURE;
    }

    pthread_t     readers[MAX_THREADS], writers[MAX_THREADS];
    thread_args_t reader_args[MAX_THREADS], writer_args[MAX_THREADS];
    int readers_created = 0, writers_created = 0;

    // Spawn n reader threads
    for (int i = 0; i < n; i++) {
        reader_args[i].state = &state;
        reader_args[i].id    = i + 1;
        int rc = pthread_create(&readers[i], NULL, reader_thread, &reader_args[i]);
        if (rc != 0) {
            fprintf(stderr, "Error: pthread_create reader %d: %s\n",
                    i + 1, strerror(rc));
            // Adjust active_readers so writers don't hang waiting forever
            pthread_mutex_lock(&state.queue_mutex);
            state.active_readers -= (n - i);
            if (state.active_readers <= 0) {
                state.active_readers = 0;
                pthread_cond_broadcast(&state.not_empty);
            }
            pthread_mutex_unlock(&state.queue_mutex);
            break;
        }
        readers_created++;
    }

    // Spawn n writer threads
    for (int i = 0; i < n; i++) {
        writer_args[i].state = &state;
        writer_args[i].id    = i + 1;
        int rc = pthread_create(&writers[i], NULL, writer_thread, &writer_args[i]);
        if (rc != 0) {
            fprintf(stderr, "Error: pthread_create writer %d: %s\n",
                    i + 1, strerror(rc));
            break;
        }
        writers_created++;
    }

    // Wait for all threads to finish
    for (int i = 0; i < readers_created; i++)
        pthread_join(readers[i], NULL);
    for (int i = 0; i < writers_created; i++)
        pthread_join(writers[i], NULL);

    // Release synchronisation resources and close file descriptors
    pthread_cond_destroy(&state.not_empty);
    pthread_cond_destroy(&state.not_full);
    pthread_mutex_destroy(&state.read_mutex);
    pthread_mutex_destroy(&state.queue_mutex);
    close(src_fd);
    close(dst_fd);

    return EXIT_SUCCESS;
}
